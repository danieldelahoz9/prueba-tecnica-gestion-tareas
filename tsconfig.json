{
  "compilerOptions": {
    // Dónde está mi código y dónde se guarda el compilado
    "rootDir": "./src",
    "outDir": "./dist",

    // Configuración para Node con CommonJS
    "module": "commonjs",
    "target": "ES2020",
    "esModuleInterop": true,

    // Revisión estricta de tipos (buena práctica)
    "strict": true,

    // Evita errores dentro de librerías externas
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}